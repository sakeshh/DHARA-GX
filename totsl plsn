## **5. ORCHESTRATOR - LangGraph State Machine**

```python
# orchestrator.py
from langgraph.graph import StateGraph, END
from typing import TypedDict, Optional

class OrchestratorState(TypedDict):
    session_id: str
    user_request: str
    current_phase: str
    assessment: Optional[AssessmentResult]
    plan: Optional[ETLPlan]
    review: Optional[ReviewResult]
    code: Optional[CodeArtifact]
    validation: Optional[ValidationResult]
    execution: Optional[ExecutionResult]
    errors: List[str]
    human_input_needed: bool
    human_input_type: Optional[str]

class AgentDharaOrchestrator:
    def __init__(self, memory_store: MemoryStore):
        self.memory = memory_store
        self.swarm = AssessmentSwarm(memory_store)
        self.etl_pipeline = ETLPipelineOrchestrator(memory_store)
        self.graph = self._build_graph()
    
    def _build_graph(self) -> StateGraph:
        workflow = StateGraph(OrchestratorState)
        
        # Assessment phases
        workflow.add_node("load_data", self._load_data)
        workflow.add_node("run_assessment_swarm", self._run_assessment_swarm)
        workflow.add_node("present_assessment", self._present_assessment)
        
        # ETL phases
        workflow.add_node("plan_etl", self._plan_etl)
        workflow.add_node("review_plan", self._review_plan)
        workflow.add_node("human_review_gate", self._human_review_gate)
        workflow.add_node("generate_code", self._generate_code)
        workflow.add_node("validate_code", self._validate_code)
        workflow.add_node("human_approval_gate", self._human_approval_gate)
        workflow.add_node("execute_code", self._execute_code)
        workflow.add_node("record_learning", self._record_learning)
        
        # Edges
        workflow.set_entry_point("load_data")
        workflow.add_edge("load_data", "run_assessment_swarm")
        workflow.add_edge("run_assessment_swarm", "present_assessment")
        
        # After assessment: user chooses path
        workflow.add_conditional_edges(
            "present_assessment",
            self._route_after_assessment,
            {
                "etl_pipeline": "plan_etl",
                "chat_query": "chat_response",
                "new_assessment": "load_data",
            }
        )
        
        # ETL pipeline
        workflow.add_edge("plan_etl", "review_plan")
        workflow.add_edge("review_plan", "human_review_gate")
        workflow.add_conditional_edges(
            "human_review_gate",
            lambda s: "generate_code" if s.get("review", {}).get("can_proceed") else "plan_etl",
            {"generate_code": "generate_code", "plan_etl": "plan_etl"}
        )
        workflow.add_edge("generate_code", "validate_code")
        workflow.add_conditional_edges(
            "validate_code",
            lambda s: "human_approval_gate" if s["validation"].passed else "generate_code",
            {"human_approval_gate": "human_approval_gate", "generate_code": "generate_code"}
        )
        workflow.add_edge("human_approval_gate", "execute_code")
        workflow.add_edge("execute_code", "record_learning")
        workflow.add_edge("record_learning", END)
        
        return workflow.compile(checkpointer=MemorySaver())
    
    async def _run_assessment_swarm(self, state: OrchestratorState) -> OrchestratorState:
        # Load data from sources
        datasets = await self._load_datasets(state["session_id"])
        
        # Run assessment swarm
        assessment = await self.swarm.run(datasets, state.get("assessment_config"))
        
        return {**state, "assessment": assessment, "current_phase": "assessment_complete"}
    
    async def _plan_etl(self, state: OrchestratorState) -> OrchestratorState:
        plan_result = await self.etl_pipeline.planner_agent.run_with_retry({
            "assessment": state["assessment"],
            "business_rules": state.get("business_rules", {}),
            "user_preferences": state.get("user_preferences", {}),
        })
        
        if not plan_result.success:
            return {**state, "errors": plan_result.errors, "current_phase": "planning_failed"}
        
        return {**state, "plan": plan_result.data["plan"], "current_phase": "planned"}
    
    async def _human_review_gate(self, state: OrchestratorState) -> OrchestratorState:
        review = state["review"]
        if not review["can_proceed"]:
            # Present review results to user, wait for input
            return {**state, "human_input_needed": True, "human_input_type": "plan_review"}
        
        # Check if user provided manual review resolutions
        if state.get("human_input"):
            resolutions = state["human_input"]
            updated_plan = await self.etl_pipeline.apply_resolutions(state["plan"], resolutions)
            return {**state, "plan": updated_plan, "human_input_needed": False}
        
        return state
