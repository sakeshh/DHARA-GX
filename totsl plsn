        full_sql = self._assemble_sql(infra_sql, cleanse_scripts, transform_scripts, plan)
        
        # Self-validation loop
        validation_result = await self.validator.validate(full_sql, assessment, plan)
        if not validation_result.passed:
            # Try to auto-fix
            fixed_sql = await self._auto_fix(full_sql, validation_result.errors, assessment)
            if fixed_sql:
                full_sql = fixed_sql
        
        return AgentResult(True, {"sql": full_sql, "validation": validation_result}, [], [], {
            "dialect": "tsql",
            "scripts_generated": 1 + len(cleanse_scripts) + len(transform_scripts),
        })
    
    async def _generate_cleanse_script(self, ds_plan, assessment, plan) -> str:
        # Build column expressions for each step
        column_exprs = {}
        for step in ds_plan.steps:
            if step.action in self.supported_column_actions:
                expr = self._compile_column_expression(step, assessment, plan)
                column_exprs[step.column] = expr
        
        # Render template
        return self.templates.render_cleanse(
            source_table=ds_plan.dataset,
            target_table=self._get_clean_table_name(ds_plan.dataset),
            columns=column_exprs,
            watermark_col=self._detect_watermark(assessment, ds_plan.dataset),
        )
