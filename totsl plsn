# assessment_swarm.py
class AssessmentSwarm:
    def __init__(self, memory_store: "MemoryStore"):
        self.memory = memory_store
        self.agents = {
            "profile": ProfileAgent(memory_store),
            "semantic": SemanticAgent(memory_store),
            "key": KeyAgent(memory_store),
            "dq": DQAgent(memory_store),
            "relationship": RelationshipAgent(memory_store),
            "synthesis": SynthesisAgent(memory_store),
        }
    
    async def run(self, datasets: Dict[str, pd.DataFrame], config: AssessmentConfig) -> AssessmentResult:
        # Prepare shared inputs
        shared_inputs = {
            "datasets": datasets,
            "config": config,
            "db_connectors": config.db_connectors or {},
        }
        
        # PHASE 1: Independent parallel
        phase1_results = await asyncio.gather(
            self.agents["profile"].run_with_retry(shared_inputs),
            self.agents["semantic"].run_with_retry({**shared_inputs, "profiles": {}}),  # will wait for profile
            self.agents["key"].run_with_retry({**shared_inputs, "profiles": {}}),
        )
        
        # Check phase 1 success
        for r in phase1_results:
            if not r.success:
                raise AssessmentError(f"Phase 1 failed: {r.errors}")
        
        # Merge phase 1 outputs
        phase1_data = {}
        for r in phase1_results:
            phase1_data.update(r.data)
        shared_inputs.update(phase1_data)
        
        # PHASE 2: Dependent parallel
        phase2_results = await asyncio.gather(
            self.agents["dq"].run_with_retry(shared_inputs),
            self.agents["relationship"].run_with_retry(shared_inputs),
        )
        
        for r in phase2_results:
            if not r.success:
                raise AssessmentError(f"Phase 2 failed: {r.errors}")
        
        # Merge phase 2 outputs
        for r in phase2_results:
            shared_inputs.update(r.data)
        
        # PHASE 3: Synthesis
        synthesis_result = await self.agents["synthesis"].run_with_retry(shared_inputs)
        if not synthesis_result.success:
            raise AssessmentError(f"Synthesis failed: {synthesis_result.errors}")
        
        return synthesis_result.data["assessment_result"]
