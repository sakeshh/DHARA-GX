```python
# agent/etl_pipeline/incremental/strategy.py

from abc import ABC, abstractmethod
from dataclasses import dataclass
from enum import Enum
from typing import Any, Dict, List, Optional

class IncrementalStrategy(Enum):
    WATERMARK = "watermark"           # timestamp column
    CDC = "cdc"                       # change data capture / log
    FILE_MANIFEST = "file_manifest"   # file listing + hash
    CURSOR = "cursor"                 # API pagination token
    OFFSET = "offset"                 # Kafka offset
    CHANGE_FEED = "change_feed"       # Cosmos DB / DynamoDB streams
    DELTA_CDF = "delta_cdf"           # Delta Lake Change Data Feed
    FULL_REFRESH = "full_refresh"     # no incremental possible

@dataclass
class IncrementalConfig:
    strategy: IncrementalStrategy
    # Watermark
    watermark_column: Optional[str] = None
    lookback_window: str = "7d"       # late arrival handling
    # CDC
    cdc_source: Optional[str] = None  # "debezium", "sql_cdc", "delta_cdf"
    # File-based
    file_pattern: Optional[str] = None
    manifest_path: Optional[str] = None
    # Cursor/API
    cursor_field: Optional[str] = None
    page_size: int = 1000
    # Delta Lake
    delta_table_path: Optional[str] = None
    starting_version: Optional[int] = None
    # General
    partition_strategy: str = "by_day"  # "by_day", "by_month", "by_hour", "none"
    idempotency_key: Optional[str] = None  # for exactly-once

class IncrementalStrategyBase(ABC):
    """Base class - each source implements this"""
    
    @abstractmethod
    async def get_last_state(self, dataset: str) -> Dict[str, Any]:
        """Returns: {watermark: ..., cursor: ..., offset: ..., version: ...}"""
        pass
    
    @abstractmethod
    async def get_changes(self, dataset: str, since: Dict[str, Any]) -> DataFrame:
        """Returns incremental changes since last state"""
        pass
    
    @abstractmethod
    async def write_changes(self, dataset: str, changes: DataFrame, mode: str) -> WriteResult:
        """Writes changes with idempotency"""
        pass
    
    @abstractmethod
    async def get_current_state(self, dataset: str) -> Dict[str, Any]:
        """Returns current state after write (for next run)"""
        pass
```

