## **RECOMMENDED: 3-PASS PIPELINE**

### **Pass 1: Fast Pattern Semantic (Parallel with Profiling)**
```python
# Runs in ~200ms per column, no LLM
def fast_semantic_pass(series: pd.Series, col_name: str) -> RoughSemantic:
    # Pure regex/pattern matching
    patterns = {
        "email": r"^[^@]+@[^@]+\.[^@]+$",
        "phone": r"^[\d\s\-\+\(\)]{10,}$",
        "uuid": r"^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
        "url": r"^https?://",
        "date_iso": r"^\d{4}-\d{2}-\d{2}$",
        "currency": r"^\$?[\d,]+\.?\d*$",
        "percentage": r"^\d+(\.\d+)?%?$",
    }
    
    sample = series.dropna().astype(str).head(100)
    matches = {k: sample.str.match(v).mean() for k, v in patterns.items()}
    best = max(matches, key=matches.get) if max(matches.values()) > 0.8 else "unknown"
    
    # Name-based hints
    name_hints = {
        "id": "identifier", "key": "identifier", "code": "identifier",
        "email": "email", "phone": "phone", "mobile": "phone",
        "date": "date", "created": "timestamp", "updated": "timestamp",
        "amount": "currency", "price": "currency", "cost": "currency",
        "qty": "quantity", "quantity": "quantity", "count": "quantity",
        "status": "status", "flag": "boolean", "is_": "boolean",
        "name": "name", "title": "name", "description": "text",
    }
    name_hint = next((v for k, v in name_hints.items() if k in col_name.lower()), None)
    
    return RoughSemantic(
        type=best if best != "unknown" else name_hint or "unknown",
        confidence=0.7 if best != "unknown" else (0.5 if name_hint else 0.1),
        source="pattern",
    )
```

### **Pass 2: Profiling with Rough Semantics**
```python
# Profiling uses rough semantics to SELECT right checks
def analyze_column(series, col, rough_semantic, profile_stats):
    checks = []
    
    # ALWAYS run
    checks.append(null_check)
    checks.append(type_consistency_check)
    
    # CONDITIONAL based on rough semantic
    if rough_semantic.type in ("email",):
        checks.append(email_format_check)
    elif rough_semantic.type in ("phone",):
        checks.append(phone_format_check)
    elif rough_semantic.type in ("currency", "percentage", "quantity"):
        checks.append(numeric_outlier_check)
        checks.append(negative_value_check)
    elif rough_semantic.type in ("date", "timestamp"):
        checks.append(date_format_check)
        checks.append(future_date_check)
    elif rough_semantic.type in ("identifier",):
        checks.append(uniqueness_check)
        checks.append(null_check)  # stricter
    
    # Run selected checks
    return run_checks(series, checks)
```

### **Pass 3: Refined Semantic (LLM + Stats + Profiling Results)**
```python
# Runs after profiling, uses LLM for ambiguous columns
async def refined_semantic_pass(
    series: pd.Series, 
    col_name: str, 
    profile_stats: Dict,
    dq_issues: List[Issue],
    rough_semantic: RoughSemantic
) -> RefinedSemantic:
    
    # High confidence from patterns? Skip LLM.
    if rough_semantic.confidence > 0.85 and not dq_issues:
        return RefinedSemantic(
            type=rough_semantic.type,
            confidence=rough_semantic.confidence,
            source="pattern",
        )
    
    # Build context for LLM
    context = {
        "column_name": col_name,
        "dtype": str(series.dtype),
        "null_pct": profile_stats.null_pct,
        "unique_pct": profile_stats.unique_pct,
        "top_values": profile_stats.top_values[:5],
        "sample_values": series.dropna().head(20).tolist(),
        "dq_issues": [i.type for i in dq_issues],
        "rough_semantic": rough_semantic.type,
    }
    
    # LLM inference
    llm_result = await llm_infer_semantic(context)
    
    return RefinedSemantic(
        type=llm_result.semantic_type,
        confidence=llm_result.confidence,
        source="llm",
        reasoning=llm_result.reasoning,
    )
```

