# agent/connectors/kafka_incremental.py

class KafkaIncrementalStrategy(IncrementalStrategyBase):
    """Exactly-once streaming with checkpointing"""
    
    def __init__(self, consumer: KafkaConsumer, config: IncrementalConfig):
        self.consumer = consumer
        self.config = config
    
    async def get_last_state(self, dataset: str) -> Dict:
        # Read from checkpoint topic / offset store
        offsets = await self.offset_store.get(dataset)
        return {"offsets": offsets}
    
    async def get_changes(self, dataset: str, since: Dict) -> DataFrame:
        # Seek to last committed offset
        for tp, offset in since.get("offsets", {}).items():
            self.consumer.seek(tp, offset + 1)
        
        # Poll batch
        batch = self.consumer.poll(timeout_ms=30000, max_records=10000)
        records = []
        for tp, msgs in batch.items():
            for msg in msgs:
                records.append({
                    "topic": tp.topic,
                    "partition": tp.partition,
                    "offset": msg.offset,
                    "key": msg.key,
                    "value": msg.value,
                    "timestamp": msg.timestamp
                })
        
        return pd.DataFrame(records)
    
    async def write_changes(self, dataset: str, changes: DataFrame, mode: str) -> WriteResult:
        # Write to sink with transactional producer
        producer = self.transactional_producer
        async with producer.transaction():
            for _, row in changes.iterrows():
                await producer.send(dataset, key=row[self.config.idempotency_key], value=row.to_dict())
        
        # Commit offsets after successful write
        await self.offset_store.save(dataset, self.consumer.committed_offsets())
        return WriteResult(success=True)
