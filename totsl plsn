# planner_agent.py
class PlannerAgent(BaseAgent):
    name = "planner_agent"
    required_inputs = ["assessment", "business_rules"]
    
    async def execute(self, inputs: Dict) -> AgentResult:
        assessment = inputs["assessment"]
        business_rules = inputs.get("business_rules", {})
        user_prefs = inputs.get("user_preferences", {})
        
        # 1. Load relevant memories
        schema_mem = await self.memory.get_schema_memory(assessment.datasets.keys())
        rule_mem = await self.memory.get_business_rule_memory(business_rules)
        fix_patterns = await self.memory.get_fix_patterns(
            issue_types=[i.issue_type for i in assessment.all_issues]
        )
        
        # 2. Generate base transformations (parallel per dataset)
        dataset_plans = await asyncio.gather(*[
            self._plan_dataset(ds_name, ds_info, assessment, business_rules, fix_patterns)
            for ds_name, ds_info in assessment.datasets.items()
        ])
        
        # 3. Build cross-dataset steps (joins, relationships)
        cross_dataset_steps = self._plan_cross_dataset(assessment, business_rules)
        
        # 4. Generate manual review items from DQ blockers
        manual_review = self._build_manual_review(assessment, dataset_plans)
        
        # 5. Enrich with memories
        plan = ETLPlan(
            plan_id=generate_plan_id(),
            datasets={dp.dataset: dp for dp in dataset_plans},
            cross_dataset_steps=cross_dataset_steps,
            manual_review=manual_review,
            engine_recommendation=self._recommend_engine(assessment, business_rules),
            cleaning_plan=self._build_cleaning_plan(assessment, business_rules),
            coverage_report=self._build_coverage_report(assessment, dataset_plans),
            reconciliation=self._build_reconciliation(assessment, dataset_plans),
        )
        
        # 6. Store in memory for future
        await self.memory.store_plan_pattern(plan, assessment)
        
        return AgentResult(True, {"plan": plan}, [], [], {
            "datasets_planned": len(dataset_plans),
            "total_steps": sum(len(dp.steps) for dp in dataset_plans),
            "manual_review_items": len(manual_review),
        })
    
    async def _plan_dataset(self, ds_name, ds_info, assessment, biz_rules, fix_patterns) -> DatasetPlan:
        # Get assessment issues for this dataset
        issues = assessment.get_dataset_issues(ds_name)
        
        # Map each issue → transformation step using fix patterns
        steps = []
        for issue in issues:
            # Check fix pattern memory first
            pattern = fix_patterns.get(issue.issue_type)
            if pattern and pattern.success_rate > 0.8:
                action = pattern.recommended_action
                confidence = pattern.success_rate
            else:
                # Fall back to transformation_suggester
                suggestion = suggest_transformations_for_issue(issue, ds_info)
                action = suggestion.action
                confidence = suggestion.confidence
            
            step = PlanStep(
                step_id=make_step_id(ds_name, issue.column, action),
                dataset=ds_name,
                column=issue.column,
                action=action,
                source_issue_id=issue.id,
                source_issue_type=issue.issue_type,
                confidence=confidence,
                params=self._build_params(action, issue, ds_info),
                evidence_id=f"issue_{issue.id}",
            )
            steps.append(step)
        
        # Add proactive steps (trim, type cast) based on semantics
        proactive_steps = self._add_proactive_steps(ds_info, assessment)
        steps.extend(proactive_steps)
        
        return DatasetPlan(dataset=ds_name, steps=steps)
