class BusinessLogicEngine:
    """
    Discovers and validates multi-column business rules automatically
    """
    
    def discover_rules(self, df: pd.DataFrame, semantic: SemanticProfile) -> List[BusinessRule]:
        rules = []
        
        # 1. Functional Dependencies (A → B)
        rules.extend(self._find_functional_dependencies(df, semantic))
        
        # 2. Conditional Constraints (IF X THEN Y)
        rules.extend(self._find_conditional_constraints(df, semantic))
        
        # 3. Aggregation Consistency (SUM(detail) = header)
        rules.extend(self._find_aggregation_rules(df, semantic))
        
        # 4. Temporal Logic (start < end, no gaps)
        rules.extend(self._find_temporal_rules(df, semantic))
        
        # 4. State Machines (status transitions)
        rules.extend(self._find_state_machines(df, semantic))
        
        return rules
    
    def _find_conditional_constraints(self, df, semantic) -> List[BusinessRule]:
        rules = []
        
        # For each categorical column, check if it implies constraints on others
        for cat_col in semantic.categorical_columns:
            for value in df[cat_col].unique():
                subset = df[df[cat_col] == value]
                
                # Check other columns for conditional patterns
                for target_col in semantic.numeric_columns + semantic.date_columns:
                    # Null pattern
                    null_pct = subset[target_col].isnull().mean()
                    if null_pct < 0.01 and df[target_col].isnull().mean() > 0.1:
                        rules.append(BusinessRule(
                            type="conditional_not_null",
                            condition=f"{cat_col} == '{value}'",
                            target=target_col,
                            confidence=0.9,
                            source="discovered",
                        ))
                    
                    # Range pattern
                    if target_col in semantic.numeric_columns:
                        min_val, max_val = subset[target_col].min(), subset[target_col].max()
                        if min_val > 0 and df[target_col].min() <= 0:
                            rules.append(BusinessRule(
                                type="conditional_range",
                                condition=f"{cat_col} == '{value}'",
                                target=target_col,
                                min=min_val,
                                confidence=0.8,
                            ))
        
        return rules
    
    def validate_rules(self, df: pd.DataFrame, rules: List[BusinessRule]) -> List[Violation]:
        """Run discovered + declared rules"""
        violations = []
        for rule in rules:
            viol = rule.check(df)
            if viol.count > 0:
                violations.append(Violation(rule=rule, count=viol.count, rows=viol.rows))
        return violations
