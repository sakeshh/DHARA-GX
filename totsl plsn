# agent/connectors/api_incremental.py

class APIIncrementalStrategy(IncrementalStrategyBase):
    """Generic REST API incremental with cursor/pagination"""
    
    def __init__(self, client: APIClient, config: IncrementalConfig):
        self.client = client
        self.config = config
    
    async def get_last_state(self, dataset: str) -> Dict:
        state = await self.state_store.get(dataset)
        return {
            "cursor": state.get("cursor"),
            "last_sync": state.get("last_sync"),
            "page": state.get("page", 1)
        }
    
    async def get_changes(self, dataset: str, since: Dict) -> DataFrame:
        cursor = since.get("cursor")
        all_records = []
        
        async for page in self.client.paginate(
            endpoint=dataset,
            cursor=cursor,
            page_size=self.config.page_size,
            since=since.get("last_sync")
        ):
            all_records.extend(page["data"])
            cursor = page.get("next_cursor")
            if not cursor:
                break
        
        df = pd.DataFrame(all_records)
        df["_ingested_at"] = datetime.utcnow()
        df["_cursor"] = cursor
        return df
    
    async def write_changes(self, dataset: str, changes: DataFrame, mode: str) -> WriteResult:
        # Upsert by business key
        business_key = self.config.idempotency_key or "id"
        
        for _, record in changes.iterrows():
            await self.client.upsert(
                endpoint=dataset,
                key=record[business_key],
                data=record.to_dict()
            )
        
        return WriteResult(success=True, rows_written=len(changes))
