```python
# base_agent.py
from abc import ABC, abstractmethod
from typing import Any, Dict, List, Optional
from dataclasses import dataclass
import asyncio

@dataclass
class AgentResult:
    success: bool
    data: Any
    errors: List[str]
    warnings: List[str]
    metadata: Dict[str, Any]

class BaseAgent(ABC):
    def __init__(self, memory_store: "MemoryStore", config: Dict = None):
        self.memory = memory_store
        self.config = config or {}
        self.logger = logging.getLogger(f"agent.{self.name}")
    
    @property
    @abstractmethod
    def name(self) -> str: pass
    
    @property
    @abstractmethod
    def required_inputs(self) -> List[str]: pass  # e.g., ["profiles", "semantics"]
    
    @abstractmethod
    async def execute(self, inputs: Dict[str, Any]) -> AgentResult: pass
    
    async def run_with_retry(self, inputs: Dict, max_retries: int = 2) -> AgentResult:
        for attempt in range(max_retries + 1):
            try:
                result = await self.execute(inputs)
                if result.success:
                    return result
                self.logger.warning(f"{self.name} attempt {attempt+1} failed: {result.errors}")
            except Exception as e:
                self.logger.error(f"{self.name} attempt {attempt+1} exception: {e}")
                if attempt == max_retries:
                    return AgentResult(False, None, [str(e)], [], {})
        return AgentResult(False, None, ["Max retries exceeded"], [], {})


# profile_agent.py
