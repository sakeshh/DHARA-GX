### **3.3 Reviewer Agent - Quality Gate**

```python
# reviewer_agent.py
class ReviewerAgent(BaseAgent):
    name = "reviewer_agent"
    required_inputs = ["plan", "assessment"]
    
    async def execute(self, inputs: Dict) -> AgentResult:
        plan = inputs["plan"]
        assessment = inputs["assessment"]
        
        review_results = {
            "coverage": self._check_coverage(plan, assessment),
            "traceability": self._check_traceability(plan, assessment),
            "risk_assessment": self._assess_risk(plan, assessment),
            "best_practices": self._check_best_practices(plan),
            "suggestions": [],
        }
        
        # Generate actionable suggestions
        if review_results["coverage"]["pct"] < 90:
            review_results["suggestions"].append({
                "type": "coverage_gap",
                "message": f"Only {review_results['coverage']['pct']}% of issues have steps",
                "action": "Add steps for unmatched issues or mark as manual review",
            })
        
        if review_results["risk_assessment"]["high_risk_steps"] > 0:
            review_results["suggestions"].append({
                "type": "high_risk",
                "message": f"{review_results['risk_assessment']['high_risk_steps']} steps are high risk",
                "action": "Review destructive operations (drop, delete, truncate)",
            })
        
        # Determine if plan can proceed
        can_proceed = (
            review_results["coverage"]["pct"] >= 80 and
            review_results["traceability"]["missing_evidence"] == 0 and
            review_results["risk_assessment"]["blocking"] == 0
        )
        
        return AgentResult(
            success=can_proceed,
            data={"review": review_results},
            errors=[] if can_proceed else ["Plan review failed - see suggestions"],
            warnings=review_results["suggestions"],
            metadata={"can_proceed": can_proceed}
        )
    
    def _check_coverage(self, plan, assessment) -> Dict:
        total_issues = sum(len(ds.issues) for ds in assessment.datasets.values())
        covered_issues = set()
        
        for ds_plan in plan.datasets.values():
            for step in ds_plan.steps:
                if step.source_issue_id:
                    covered_issues.add(step.source_issue_id)
        
        return {
            "total_issues": total_issues,
            "covered_issues": len(covered_issues),
            "pct": round(len(covered_issues) / max(1, total_issues) * 100, 1),
            "uncovered": [i for i in assessment.all_issues if i.id not in covered_issues],
        }
    
    def _check_traceability(self, plan, assessment) -> Dict:
        missing = []
        for ds_plan in plan.datasets.values():
            for step in ds_plan.steps:
                if not step.evidence_id:
                    missing.append(f"{ds_plan.dataset}.{step.column}.{step.action}")
        return {"missing_evidence": len(missing), "details": missing}
