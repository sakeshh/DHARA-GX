# agent/connectors/delta_incremental.py

class DeltaIncrementalStrategy(IncrementalStrategyBase):
    """Native Delta Lake incremental - uses CDF (Change Data Feed)"""
    
    def __init__(self, spark: SparkSession, config: IncrementalConfig):
        self.spark = spark
        self.config = config
    
    async def get_last_state(self, dataset: str) -> Dict:
        # Read last processed version from checkpoint
        checkpoint_path = f"{self.config.delta_table_path}/_checkpoints/{dataset}"
        try:
            df = self.spark.read.json(checkpoint_path)
            return {"version": df.agg(max("version")).collect()[0][0]}
        except:
            return {"version": 0}
    
    async def get_changes(self, dataset: str, since: Dict) -> DataFrame:
        version = since.get("version", 0)
        
        # USE DELTA CDF - most efficient!
        if self.config.strategy == IncrementalStrategy.DELTA_CDF:
            return self.spark.read.format("delta") \
                .option("readChangeFeed", "true") \
                .option("startingVersion", version + 1) \
                .load(self.config.delta_table_path)
        
        # Fallback: time travel + watermark
        watermark_col = self.config.watermark_column
        return self.spark.read.format("delta") \
            .load(self.config.delta_table_path) \
            .filter(f"{watermark_col} > '{since.get('watermark', '1900-01-01')}'")
    
    async def write_changes(self, dataset: str, changes: DataFrame, mode: str) -> WriteResult:
        # Delta MERGE with SCD support
        target_table = f"{self.config.delta_table_path}/{dataset}"
        
        if self.config.scd_type == 2:
            # SCD Type 2 merge
            merge_sql = self._build_scd2_merge(target_table, changes)
        else:
            # Simple upsert
            merge_sql = self._build_upsert_merge(target_table, changes)
        
        self.spark.sql(merge_sql)
        
        # Optimize & VACUUM periodically
        if random.random() < 0.1:  # 10% of runs
            self.spark.sql(f"OPTIMIZE {target_table}")
            self.spark.sql(f"VACUUM {target_table} RETAIN 168 HOURS")
        
        return WriteResult(success=True)
```

