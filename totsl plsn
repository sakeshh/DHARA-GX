    def __init__(self):
        self.declared_rules = []      # From business_rules.yaml
        self.discovered_rules = []    # From BusinessLogicEngine
        self.inferred_rules = []      # From SemanticAnalyzer
        self.rule_registry = RuleRegistry()
    
    def load_declared_rules(self, business_rules: Dict) -> List[Rule]:
        """Parse business_rules.yaml into executable rules"""
        rules = []
        
        # Valid values / enums
        for col, values in business_rules.get("valid_values", {}).items():
            rules.append(EnumRule(column=col, allowed=values))
        
        # Cross-field formulas
        for formula in business_rules.get("formula_rules", []):
            rules.append(FormulaRule(
                assertion=formula["assertion"],
                severity=formula.get("severity", "medium"),
                message=formula.get("message"),
            ))
        
        # Conditional rules
        for cond in business_rules.get("conditional_rules", []):
            rules.append(ConditionalRule(
                if_condition=cond["if"],
                then_constraint=cond["then"],
            ))
        
        # Aggregation rules
        for agg in business_rules.get("aggregation_rules", []):
            rules.append(AggregationRule(
                group_by=agg["group_by"],
                measure=agg["measure"],
                expected=agg["expected"],  # "sum", "count", "unique"
                tolerance=agg.get("tolerance", 0.01),
            ))
        
        # Lookup/master data
        for lookup in business_rules.get("lookups", []):
            rules.append(LookupRule(
                column=lookup["column"],
                reference_table=lookup["reference"],
                reference_column=lookup["ref_column"],
                fuzzy=lookup.get("fuzzy", False),
            ))
        
        self.declared_rules = rules
        return rules
    
    def run_all(self, df: pd.DataFrame, semantic: SemanticProfile) -> ValidationResult:
        # 1. Run declared rules
        declared_violations = self._run_rules(df, self.declared_rules)
        
        # 2. Run discovered rules (auto-found)
        discovered_violations = self._run_rules(df, self.discovered_rules)
        
        # 3. Run inferred rules (from semantic understanding)
        inferred_violations = self._run_rules(df, self.inferred_rules)
        
        # 4. Reconcile conflicts (declared vs discovered)
        conflicts = self._reconcile_conflicts(
            declared_violations, discovered_violations, inferred_violations
        )
        
        return ValidationResult(
            declared=declared_violations,
            discovered=discovered_violations,
            inferred=inferred_violations,
            conflicts=conflicts,
        )
```

### **5. HISTORICAL BASELINE & DRIFT DETECTION**

```python
# NEW: agent/profiling/drift_detector.py
class DriftDetector:
    """
    Compares current assessment against historical baselines
    """
    
    def __init__(self, memory: MemoryStore):
        self.memory = memory
    
    async def detect_drift(self, 
                           current: AssessmentResult, 
                           dataset_name: str) -> DriftReport:
        
        # Load historical baselines
        baselines = await self.memory.get_historical_baselines(dataset_name, lookback=30)
        
        if not baselines:
            return DriftReport(status="no_baseline", message="First assessment for this dataset")
        
        drift_report = DriftReport()
        
        # 1. Schema drift
        drift_report.schema_changes = self._compare_schemas(current, baselines[-1])
        
        # 2. Statistical drift (KS test, PSI)
        drift_report.distribution_shifts = self._compute_psi(current, baselines)
        
        # 3. Quality metric drift
        drift_report.quality_drift = self._compare_quality_metrics(current, baselines)
        
        # 4. Semantic drift (new categories, changed patterns)
        drift_report.semantic_drift = self._compare_semantics(current, baselines)
        
        # 5. Business rule compliance drift
        drift_report.rule_compliance_drift = self._compare_rule_compliance(current, baselines)
        
        return drift_report
    
    def _compute_psi(self, current, baselines) -> List[DriftSignal]:
        """Population Stability Index - standard for drift detection"""
        signals = []
        for col in current.numeric_columns:
            current_dist = current.get_distribution(col)
            baseline_dist = baselines[-1].get_distribution(col)
            
            psi = self._population_stability_index(current_dist, baseline_dist)
            if psi > 0.2:  # Significant drift
                signals.append(DriftSignal(
                    column=col,
                    metric="PSI",
                    value=psi,
                    threshold=0.2,
                    severity="high" if psi > 0.5 else "medium",
                ))
        return signals
