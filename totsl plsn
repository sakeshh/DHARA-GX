class ContextualAnomalyDetector:
    """
    Finds anomalies that are only visible in CONTEXT - what analysts spot by eye
    """
    
    def detect(self, df: pd.DataFrame, semantic: SemanticProfile, 
               historical: Optional[HistoricalProfile] = None) -> List[Anomaly]:
        anomalies = []
        
        # 1. SEASONAL/TREND ANOMALIES (time-series)
        if semantic.has_time_series:
            anomalies.extend(self._detect_trend_breaks(df, semantic))
            anomalies.extend(self._detect_seasonal_violations(df, semantic))
        
        # 2. POPULATION STABILITY (drift vs training/reference)
        if historical:
            anomalies.extend(self._detect_population_shift(df, historical))
        
        # 3. SEGMENT-LEVEL ANOMALIES (global OK, but broken in segment)
        anomalies.extend(self._detect_segment_anomalies(df, semantic))
        
        # 4. RARE CATEGORY ANOMALIES (new values appearing)
        anomalies.extend(self._detect_category_drift(df, semantic))
        
        # 5. CORRELATION BREAKDOWNS (A vs B relationship changed)
        anomalies.extend(self._detect_correlation_shifts(df, semantic, historical))
        
        # 6. BUSINESS KEY COLLISIONS (same natural key, different attributes)
        anomalies.extend(self._detect_key_collisions(df, semantic))
        
        return anomalies
    
    def _detect_segment_anomalies(self, df, semantic) -> List[Anomaly]:
        """Global metrics look fine, but segment is broken"""
        anomalies = []
        
        for segment_col in semantic.segment_columns:  # e.g., country, channel, product_line
            for segment_value in df[segment_col].unique():
                segment = df[df[segment_col] == segment_value]
                
                # Check if segment has issues global doesn't
                for metric_col in semantic.numeric_columns:
                    global_mean = df[metric_col].mean()
                    segment_mean = segment[metric_col].mean()
                    
                    if abs(segment_mean - global_mean) / global_mean > 0.5:  # 50% deviation
                        anomalies.append(Anomaly(
                            type="segment_anomaly",
                            segment={segment_col: segment_value},
                            metric=metric_col,
                            expected=global_mean,
                            actual=segment_mean,
                            severity="high" if segment.shape[0] > 100 else "medium",
                            message=f"{segment_col}='{segment_value}' has {metric_col} mean {segment_mean:.2f} vs global {global_mean:.2f}"
                        ))
        
        return anomalies
