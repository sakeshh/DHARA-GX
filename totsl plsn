# agent/connectors/blob_incremental.py

class BlobIncrementalStrategy(IncrementalStrategyBase):
    """Handles CSV, Parquet, JSON, Avro, Excel on Blob/ADLS"""
    
    def __init__(self, connector: AzureBlobConnector, config: IncrementalConfig):
        self.connector = connector
        self.config = config
        self.manifest_store = ManifestStore()
    
    async def get_last_state(self, dataset: str) -> Dict:
        # Read manifest: {file_path: {hash, size, modified, processed_at}}
        manifest = await self.manifest_store.load(dataset)
        return {"manifest": manifest}
    
    async def get_changes(self, dataset: str, since: Dict) -> DataFrame:
        manifest = since.get("manifest", {})
        
        # List all files matching pattern
        all_files = await self.connector.list_files(
            prefix=self.config.file_pattern or "",
            recursive=True
        )
        
        # Find new/changed files
        new_files = []
        for file_info in all_files:
            path = file_info["path"]
            file_hash = file_info["hash"]
            
            if path not in manifest:
                new_files.append(file_info)  # New file
            elif manifest[path]["hash"] != file_hash:
                new_files.append(file_info)  # Changed file
        
        if not new_files:
            return empty_dataframe()
        
        # Read only new/changed files
        dfs = []
        for f in new_files:
            df = await self.connector.read_file(f["path"], format=self._detect_format(f["path"]))
            df["_source_file"] = f["path"]
            df["_file_modified"] = f["modified"]
            dfs.append(df)
        
        combined = pd.concat(dfs, ignore_index=True)
        
        # Update manifest
        new_manifest = manifest.copy()
        for f in new_files:
            new_manifest[f["path"]] = {
                "hash": f["hash"],
                "size": f["size"],
                "modified": f["modified"],
                "processed_at": datetime.utcnow().isoformat()
            }
        await self.manifest_store.save(dataset, new_manifest)
        
        return combined
    
    async def write_changes(self, dataset: str, changes: DataFrame, mode: str) -> WriteResult:
        # Partition by date
        if self.config.partition_strategy != "none":
            changes["_partition_date"] = changes[self.config.watermark_column or "processed_date"].dt.date
            for partition, partition_df in changes.groupby("_partition_date"):
                path = f"{dataset}/year={partition.year}/month={partition.month:02d}/day={partition.day:02d}/"
                await self.connector.write_parquet(partition_df, path, mode="overwrite")
        else:
            await self.connector.write_parquet(changes, f"{dataset}/", mode="append")
        
        return WriteResult(success=True, rows_written=len(changes))
```

