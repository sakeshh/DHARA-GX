# quality_critic.py
class QualityCritic(BaseAgent):
    """Scores outputs and feeds back to improve future runs"""
    
    name = "quality_critic"
    required_inputs = ["artifact", "artifact_type", "context"]
    
    async def execute(self, inputs: Dict) -> AgentResult:
        artifact = inputs["artifact"]
        artifact_type = inputs["artifact_type"]  # "plan", "code", "execution"
        context = inputs["context"]
        
        if artifact_type == "plan":
            return await self._critique_plan(artifact, context)
        elif artifact_type == "code":
            return await self._critique_code(artifact, context)
        elif artifact_type == "execution":
            return await self._critique_execution(artifact, context)
    
    async def _critique_plan(self, plan: ETLPlan, context: Dict) -> AgentResult:
        scores = {
            "completeness": self._score_completeness(plan, context),
            "correctness": self._score_correctness(plan, context),
            "maintainability": self._score_maintainability(plan),
            "performance": self._score_performance(plan, context),
        }
        
        overall = sum(scores.values()) / len(scores)
        
        # Extract learnings
        learnings = []
        if scores["completeness"] < 0.8:
            learnings.append({
                "type": "missing_coverage",
                "pattern": self._identify_missing_pattern(plan, context),
                "recommendation": "Add transformation rules for this issue type",
            })
        
        if scores["correctness"] < 0.9:
            learnings.append({
                "type": "incorrect_mapping",
                "pattern": self._identify_wrong_mappings(plan, context),
                "recommendation": "Review issue-to-action mapping for this type",
            })
        
        return AgentResult(True, {
            "scores": scores,
            "overall": overall,
            "learnings": learnings,
        }, [], [], {})
